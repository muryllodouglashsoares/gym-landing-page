# Copie este arquivo para .env (ou .env.local) e preencha os valores
# reais. Nenhuma dessas variáveis é obrigatória para rodar o projeto
# localmente — sem elas, o site funciona normalmente, só sem envio real
# de formulário e sem analytics.

# URL do webhook do Make (ou similar) que recebe as submissões do
# formulário de contato e grava na planilha do Google Sheets.
# Sem esta variável, o envio do formulário falha com uma mensagem de
# erro amigável (ver src/lib/contact.server.ts).
CONTACT_WEBHOOK_URL=

# ID de métrica do Google Analytics 4 (formato "G-XXXXXXXXXX").
# Sem esta variável, nenhum script de analytics é carregado — não há
# coleta de dados por padrão (ver src/lib/analytics.ts).
VITE_GA_MEASUREMENT_ID=
